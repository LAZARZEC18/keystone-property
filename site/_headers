# Response headers for every host that reads this file (Cloudflare Pages and Netlify).
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=()
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; script-src 'self' https://cdnjs.cloudflare.com 'sha256-I4q8KZXGBIYHmfw0Irz+9k8SU+cG5r/IgkgoLlgOZ2Y='; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://cdnjs.cloudflare.com https://api.maptiler.com https://tile.openstreetmap.org https://*.tile.openstreetmap.org https://upload.wikimedia.org https://*.basemaps.cartocdn.com; media-src 'self'; connect-src 'self'; frame-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests

# Data files change several times a day: browsers revalidate each time.
/data/*
  Cache-Control: public, max-age=0, must-revalidate

/assets/*
  Cache-Control: public, max-age=300, must-revalidate
